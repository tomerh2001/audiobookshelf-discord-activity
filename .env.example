# Public app URLs
PUBLIC_BASE_URL=https://listen.example.com
PUBLIC_DISCORD_CLIENT_ID=replace_me

# Discord OAuth
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_BOT_TOKEN=replace_me
DISCORD_PUBLIC_KEY=replace_me
# Activity ingress authentication is mandatory in production. Set true
# to exercise the configured protection when NODE_ENV is development or test.
DISCORD_REQUIRE_PROXY_AUTH=false
# signature: Discord's optional signed proxy headers (default).
# cloudflare-worker: an origin secret attesting verified Cloudflare Worker provenance.
# See docs/security.md before selecting cloudflare-worker; CF-Worker alone is not proof.
DISCORD_PROXY_AUTH_MODE=signature
DISCORD_PROXY_EDGE_SECRET=
# restricted: allow listed Discord users or guilds. public: any verified Activity participant.
DISCORD_ACCESS_MODE=restricted
# Comma-separated IDs. Restricted access requires an allowed user OR an allowed server.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_USER_IDS=
# Explicit account revocations override user and server allowlists.
DISCORD_DENIED_USER_IDS=
DISCORD_REDIRECT_URI=https://listen.example.com/api/discord/callback

# Secrets also support *_FILE paths (Docker secrets). Remove the corresponding
# plain env value when using a file; configuring both is rejected at startup.
# DISCORD_CLIENT_SECRET_FILE=/run/secrets/discord_client_secret
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# DISCORD_PROXY_EDGE_SECRET_FILE=/run/secrets/discord_proxy_edge_secret
# APP_SESSION_SECRET_FILE=/run/secrets/app_session_secret
# TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key
# AUDIOBOOKSHELF_SHARED_PASSWORD_FILE=/run/secrets/audiobookshelf_shared_password

# App session security
APP_SESSION_SECRET=generate_32_bytes_minimum
APP_SESSION_TTL_SECONDS=28800
TOKEN_ENCRYPTION_KEY=base64_32_byte_key
DEV_AUTH_MOCK=false

# Database
DATABASE_URL=file:/data/app.db

# Audiobookshelf defaults
AUDIOBOOKSHELF_DEFAULT_SERVER_URL=https://audiobookshelf.example.com
# Public HTTPS origin for native OIDC redirects to the configured server.
# Listeners never enter or select a server address.
AUDIOBOOKSHELF_PUBLIC_SERVER_URL=
AUDIOBOOKSHELF_ALLOW_CUSTOM_SERVERS=false

# Audiobookshelf auth mode
# per-user: each Discord user links their own Audiobookshelf account in the Activity.
# shared: also offer an explicit community-account button in allowed Discord servers.
# Personal accounts remain available; passwords are never saved.
AUDIOBOOKSHELF_AUTH_MODE=per-user
# guilds: community button only in named guilds (falls back to the allowed guilds above).
# public: explicitly allow every admitted Discord participant to choose the community account.
AUDIOBOOKSHELF_COMMUNITY_ACCESS=guilds
AUDIOBOOKSHELF_COMMUNITY_GUILD_IDS=
# Uses the chosen Audiobookshelf server's native OpenID Connect provider.
AUDIOBOOKSHELF_OIDC_ENABLED=true
AUDIOBOOKSHELF_SHARED_USERNAME=
AUDIOBOOKSHELF_SHARED_PASSWORD=
# Recommended for an OIDC-only server: API key belonging to a dedicated non-admin
# Audiobookshelf user. Takes precedence over username/password; keep it server-side.
# AUDIOBOOKSHELF_SHARED_API_KEY_FILE also supports a mounted Docker secret.
AUDIOBOOKSHELF_SHARED_API_KEY=

# Maximum concurrent native players per Activity
ROOM_MAX_PARTICIPANTS=20

# CORS / security
ALLOWED_ORIGINS=https://listen.example.com
TRUST_PROXY=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
NODE_ENV=production
LOG_LEVEL=info
# Compose sets this to /data/logs in the persistent app volume. Leave empty for stdout-only local runs.
LOG_DIR=
PORT=3000
